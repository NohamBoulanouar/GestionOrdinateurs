@inherits LayoutComponentBase
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            @* utilisateur connecté et son rôle *@
            <AuthorizeView>
                <Authorized>
                    <span>@context.User.Identity?.Name (@string.Join(", ", context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value)))</span>
                </Authorized>
                <NotAuthorized>
                    <span>Non connecté</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
